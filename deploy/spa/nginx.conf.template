server {
  listen ${PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 50m;

  # Public HTTPS upstream (stable across API redeploys; avoids stale private DNS).
  resolver 8.8.8.8 8.8.4.4 ipv6=off valid=30s;
  resolver_timeout 5s;

  location = /health {
    access_log off;
    default_type text/plain;
    return 200 'ok';
  }

  location /api/ {
    set $kunk_api_host "${KUNK_API_PUBLIC_HOST}";
    proxy_http_version 1.1;
    proxy_pass https://$kunk_api_host;
    proxy_ssl_server_name on;
    proxy_ssl_name $kunk_api_host;
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;
    proxy_set_header Host $kunk_api_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_pass_header Set-Cookie;
    proxy_cookie_path / /;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2|woff|ttf|eot)$ {
    expires 30d;
    access_log off;
    add_header Cache-Control "public";
    try_files $uri =404;
  }
}
