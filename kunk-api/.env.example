PORT=8056
# Preferência: URL completa
# PG_URL=postgresql://user:pass@localhost:5432/kunk
# Ou partes (usadas se PG_URL estiver ausente):
PGHOST=localhost
PGPORT=5432
PGUSER=user
PGPASSWORD=pass
PGDATABASE=kunk
COOKIE_SECURE=false
# Allowlist só se o browser chamar a URL pública da API. Apps oficiais usam /api/v1 no próprio host (proxy); vazio = CORS desligado.
# CORS_ORIGIN=https://app-externo.example.org
SESSION_MAX_HOURS=168
STORAGE_PATH=./storage
# Files driver: local (default) | s3 | gcs — também configurável no Admin → Armazenamento
# FILES_DRIVER=local
# FILES_KEY_PREFIX=kunk/
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# GCS_BUCKET=
# GCS_PROJECT_ID=
# GCS_CLIENT_EMAIL=
# GCS_PRIVATE_KEY=
# GCS_CREDENTIALS_JSON=
NODE_ENV=development
# Rate limit de rotas públicas (exists, register-email, triagem, falhas de login). Default ligado.
# Só desligar em e2e/local (a suíte de cadastramento faz dezenas de cadastros no mesmo IP).
# AUTH_ENUM_RATE_LIMIT=0
# Master key for encrypting sensitive system_configs values (AES-256-GCM). Never put this in the DB.
CONFIG_ENCRYPT_KEY=
# URL pública da API (sem barra final). Obrigatória em produção.
# Callbacks OAuth (Google / Melhor Envio) usam só este valor — nunca Host / X-Forwarded-Host.
# Webhooks Pagar.me exigem URL alcançável pela internet (não localhost).
# Em local, deixe assim; configure PUBLIC_API_URL (ou PAGARME_WEBHOOK_PUBLIC_URL) no deploy.
PUBLIC_API_URL=http://localhost:8056
# PAGARME_WEBHOOK_PUBLIC_URL=


# Ativação de módulos: apenas Admin → Serviços externos (system_configs).
# Credenciais opcionais abaixo são fallback se system_api_credentials estiver vazio.

# PAGARME_SECRET_KEY= (ou PAGARME_TOKEN legado)
# PAGARME_PUBLIC_KEY=
# PAGARME_URL_API=https://api.pagar.me/core/v5
# PAGARME_WEBHOOK_USER=
# PAGARME_WEBHOOK_PASS=

# SOUCANNABIS_ORDERS_BASE_URL=https://api.example.com
# SOUCANNABIS_ORDERS_CLIENT_ID=
# SOUCANNABIS_ORDERS_CLIENT_SECRET=
# SOUCANNABIS_ORDERS_TOKEN_URL=

# Opcional: SISUs Loggi (csv) se store.freight.loggi.external_service_ids estiver vazio
# LOGGI_EXTERNAL_SERVICE_IDS=DLVR-DROF-DOOR-STAN-01

# Token de qualquer usuário Utalk (acesso a chats/transfer — sem envio de mensagem no OSS)
# UTALK_API_TOKEN=
# UTALK_ORG_ID=
# UTALK_FROM_PHONE=+5562999999999
# UTALK_API_URL=https://app-utalk.umbler.com/api/v1

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=  (opcional; a API grava automaticamente a partir de PUBLIC_API_URL)
# GOOGLE_REFRESH_TOKEN=

# GEOAPIFY_API_KEY=

# SMTP (fallback se system_api_credentials service=email estiver vazio)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME=Kunk

# URLs públicas dos apps (links em e-mails: reset senha, convites, termos)
KUNK_PUBLIC_URL=http://localhost:4257
ADMIN_PUBLIC_URL=http://localhost:4256
REGISTRATION_PUBLIC_URL=http://localhost:4255
DOC_SIGN_PUBLIC_URL=http://localhost:4258
